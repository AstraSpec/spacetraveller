{
  "gather": {
    "item_type_filter": ["material", "consumable"],
    "target_range": [3, 8],
    "label_template": "Gather {count} {item_name}",
    "description_template": "Bring me {count} {item_name}. Find them scattered across the world.",
    "tiers": {
      "small":  { "item_pool": ["flint", "stick", "bone", "rope"],        "amount_range": [2, 5], "friendship": 2, "romance": 0 },
      "medium": { "item_pool": ["torch", "wooden_sword", "spider_silk"],  "amount_range": [1, 2], "friendship": 4, "romance": 1 }
    }
  },
  "blacksmith_gather": {
    "giver_jobs": ["blacksmith"],
    "item_type_filter": ["material", "tool", "weapon"],
    "target_item_tags": ["JOB_BLACKSMITH"],
    "target_range": [2, 5],
    "label_template": "Bring {count} {item_name} to the forge",
    "description_template": "Bring me {count} {item_name}. I need them for forge work.",
    "tiers": {
      "small":  { "item_pool": ["iron_shard", "bone_needle", "fire_starter"], "amount_range": [1, 2], "friendship": 4, "romance": 0 },
      "medium": { "item_pool": ["wooden_sword", "torch"],                    "amount_range": [1, 2], "friendship": 6, "romance": 1 }
    }
  },
  "scavenger_gather": {
    "giver_jobs": ["scavenger"],
    "item_type_filter": ["material", "consumable", "tool"],
    "target_item_tags": ["JOB_SCAVENGER"],
    "target_range": [3, 7],
    "label_template": "Scavenge {count} {item_name}",
    "description_template": "Find me {count} {item_name}. Useful things do not stay unclaimed for long.",
    "tiers": {
      "small":  { "item_pool": ["stick", "rope", "flint", "bone"],      "amount_range": [2, 5], "friendship": 3, "romance": 0 },
      "medium": { "item_pool": ["torch", "spider_silk", "fire_starter"], "amount_range": [1, 2], "friendship": 5, "romance": 1 }
    }
  },
  "kill": {
    "race_exclude": ["human"],
    "target_range": [2, 5],
    "label_template": "Hunt {count} {race_name}",
    "description_template": "Cut down {count} {race_name}. They threaten the roads.",
    "tiers": {
      "small":  { "item_pool": ["bone", "iron_shard", "spider_silk"],     "amount_range": [1, 3], "friendship": 3, "romance": 0 },
      "medium": { "item_pool": ["rope", "torch"],                         "amount_range": [1, 2], "friendship": 5, "romance": 0 }
    }
  },
  "reach": {
    "target_range": [1, 1],
    "label_template": "Travel to a {tile_name}",
    "description_template": "Find and stand on a {tile_name} tile. Report back when you have.",
    "tiers": {
      "small":  { "item_pool": ["flint", "stick"],                        "amount_range": [2, 4], "friendship": 1, "romance": 0 }
    }
  }
}
