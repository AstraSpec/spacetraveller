anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="Canvas/DeathScreen/CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 32

[node name="YouDiedLabel" type="Label" parent="Canvas/DeathScreen/CenterContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_colors/font_color = Color(0.85, 0.2, 0.2, 1)
theme_override_font_sizes/font_size = 64
text = "You Died"
horizontal_alignment = 1

[node name="PlayAgainButton" type="Button" parent="Canvas/DeathScreen/CenterContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 4
text = "Play Again?"

[connection signal="generated" from="GameWorld" to="Canvas/Window/MapUI/Map" method="_on_world_generated"]
[connection signal="timeout" from="Player/PathfindingTimer" to="Player" method="_on_pathfinding_timer_timeout"]
[connection signal="pressed" from="Canvas/Window/InventoryUI/TabContainer/Crafting/VBoxContainer/MarginContainer/HBoxContainer/ItemDetails/VBoxContainer/CraftButton" to="Canvas/Window/InventoryUI/TabContainer/Crafting" method="_on_craft_button_pressed"]
